# GitHub/Render production example. Store real secrets in the hosting platform, never in git.
DISHA_AUTH_MODE=password
DISHA_DEV_PASSWORD=<strong-production-login-password>
DISHA_DEV_ADMIN_EMAILS=<admin-email>
DISHA_JWT_SECRET=<at-least-32-random-characters>
DISHA_WORKER_TOKEN=<at-least-24-random-characters>
DATABASE_URL=<render-postgres-internal-url>
REDIS_URL=<render-key-value-internal-url>
DISHA_BRAIN_URL=<render-brain-url>
DISHA_BRAIN_API_TOKEN=<strong-random-token>
DISHA_RESEARCH_RUNTIME_TOKEN=<strong-random-token>
DISHA_ALLOWED_ORIGINS=<public-render-url>
NEXT_PUBLIC_APP_URL=<public-render-url>
DISHA_EMBEDDING_PROVIDER=local-hash
NODE_ENV=production
